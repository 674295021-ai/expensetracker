{
  "name": "income-expense-tracker",
  "version": "1.0.0",
  "description": "Enterprise-grade Income & Expense Tracker with Google OAuth, Cloudflare Workers & D1 Database",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute income-expense-db --local --file=./migrations/0001_initial_schema.sql",
    "db:migrate:remote": "wrangler d1 execute income-expense-db --remote --file=./migrations/0001_initial_schema.sql",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "cloudflare-workers",
    "d1-database",
    "income-expense-tracker",
    "google-oauth",
    "glassmorphic-ui"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.146.0"
  }
}
